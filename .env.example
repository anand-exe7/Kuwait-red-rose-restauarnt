# Copy this file to .env.local and fill in the values.
# .env* is gitignored — never commit real credentials.

# ---------- Supabase (required for live menu / orders / realtime) ----------
# Settings → API in the Supabase dashboard.
# IMPORTANT: on Vercel these two MUST be added under Project → Settings →
# Environment Variables (Production AND Preview). Without them the public
# "Continue with Google" button is hidden on the live site, which is the usual
# reason the Google sign-in disappears on a Vercel deploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (SERVER-ONLY — never NEXT_PUBLIC_*). Used by Route Handlers
# for privileged writes. Add it to Vercel Environment Variables but keep it
# out of client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google OAuth (Supabase dashboard) ----------
# Google sign-in uses Supabase as the broker. After setting the SUPABASE_*
# vars above you also have to, in the Supabase dashboard:
#   1. Authentication → Providers → Google → enable, paste Client ID + Secret.
#   2. Authentication → URL Configuration → add your Vercel origin to
#      "Site URL" and add  https://<your-vercel-app>.vercel.app/auth/callback
#      to "Redirect URLs" (keep http://localhost:3000/auth/callback too).
#   3. In the Google Cloud console → OAuth consent + Credentials, add the
#      Supabase callback URL (shown next to the provider toggle) to
#      "Authorized redirect URIs".
# No value is needed in .env for this — it is dashboard config only.

# ---------- Public site address (REQUIRED for working WhatsApp links) ----------
# The address customers reach the site on, e.g. https://redrose.vercel.app
# Every link we put in a WhatsApp message — the invoice link, the coupon link —
# is built from this. Leave it empty and links fall back to whatever origin the
# staff device happens to be on: send a coupon from a laptop running
# `npm run dev` and the customer receives http://localhost:3000/coupon/... ,
# which cannot open on their phone. Set this on Vercel (Production AND Preview).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ---------- Shop identity (printed on every receipt / invoice) ----------
# Name, branch, owner, phone and address are read from here by app/lib/shop.ts,
# so a rebrand or a new branch is an env change, never a code change. These are
# NEXT_PUBLIC_* because the printed receipt and the public invoice page are
# rendered in the browser.
NEXT_PUBLIC_SHOP_NAME=Red Rose
NEXT_PUBLIC_SHOP_FULL_NAME=Red Rose Sweets
# Branch / neighbourhood, e.g. Al Qurain
NEXT_PUBLIC_SHOP_LOCATION=
# Proprietor, printed under the shop name on the invoice.
NEXT_PUBLIC_SHOP_OWNER=
# Contact number as a customer would dial it locally, e.g. 55568759
NEXT_PUBLIC_SHOP_PHONE=
# Full street address. Left empty, receipts fall back to "<location>, <country>".
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_COUNTRY=Kuwait

# ---------- Shop WhatsApp (required for home-order WhatsApp send) ----------
# International format, digits only, no leading + or spaces — country code
# first. Examples: 96555568759 (Kuwait 55568759), 96522000000.
# This is the number the pre-filled takeaway / delivery order message is sent to
# via https://wa.me/<NEXT_PUBLIC_SHOP_WHATSAPP>.
NEXT_PUBLIC_SHOP_WHATSAPP=

# ---------- Staff password gate ----------
# The admin portal at /admin, the waiter dashboard and the chef station all
# share one signed cookie; each role has its own password here.
ADMIN_PASSWORD=
WAITER_PASSWORD=
CHEF_PASSWORD=

# Long random string used to sign the staff session cookie.
AUTH_SECRET=

# ---------- Out-of-stock alert sound (Inventory) ----------
# Clip played in admin → Inventory when a product runs out. Any format the
# browser can play works (mp3, wav, m4a, ogg). Drop the file in /public and
# point this at it. Leave unset to use the one shipped with the app.
NEXT_PUBLIC_STOCK_ALERT_SOUND=/sounds/stock-alert.wav
